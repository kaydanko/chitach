        }
      }
    },
    "Зразок тексту — п'ять, об'єм, здоров'я.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample text — the quick brown fox jumps over the lazy dog."
