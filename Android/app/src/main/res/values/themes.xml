<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Темне тло до першого кадру: у темряві спалах білого різкий для очей.
         Та сама причина, що й UIUserInterfaceStyle=Dark у Swift-версії. -->
    <style name="Theme.Chytach" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/void_background</item>
        <item name="android:statusBarColor">@color/void_background</item>
        <item name="android:navigationBarColor">@color/void_background</item>
    </style>

    <!-- Кнопка шапки: розмір і підкладка ті самі, що на macOS. -->
    <style name="ToolButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/tool_background</item>
        <item name="android:tint">@color/on_void</item>
    </style>
</resources>
