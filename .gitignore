# аналізу функціональності. Див. Reference/README.md.
Reference/fbreader-appstore/

# Готові збірки для ручної перевірки
dist/
build-catalyst/
build-mac/

# Внутрішній план розробки — лишається локальним
PLAN.md

# Android
Android/.gradle/
Android/local.properties
Android/app/release/

# Ключі підпису. Ні файл ключа, ні паролі до нього в репозиторії не місце:
# втрата ключа означає, що оновлення поверх випущеної версії вже не
# встановляться, а витік — що чужу збірку приймуть за нашу.
Android/keystore.properties
*.jks
*.keystore
.gstack/

