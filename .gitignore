# Generated by XcodeGen — regenerate with `xcodegen generate`.
# Виняток: Package.resolved комітимо, інакше версії залежностей не зафіксовані
# і збірка не відтворювана. Git не дозволяє re-include файл, якщо виключено
# батьківський каталог, тому виключення йде посегментно.
Chytach.xcodeproj/*
!Chytach.xcodeproj/project.xcworkspace/
Chytach.xcodeproj/project.xcworkspace/*
!Chytach.xcodeproj/project.xcworkspace/xcshareddata/
Chytach.xcodeproj/project.xcworkspace/xcshareddata/*
!Chytach.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Chytach.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Chytach.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Дані покриття, які лишає інструментований бінарник на кожному запуску.
*.profraw
*.profdata

# macOS
.DS_Store

# Референсні матеріали третіх сторін — НЕ комітити.
