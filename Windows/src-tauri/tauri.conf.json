{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chytach",
  "version": "0.3.0",
  "identifier": "com.kabuki.chytach",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Chytach",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Chytach",
    "shortDescription": "Читалка електронних книг",
    "resources": {
      "../public/sample.epub": "sample.epub"
    },
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB",
        "description": "Електронна книга",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      }
    ],
    "windows": {
      "wix": {
        "language": [
          "uk-UA"
        ]
      }
    }
  }
}
